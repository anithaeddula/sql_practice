-- creation of 20 columns of table--
CREATE TABLE cartoon_shows (
    cartoon_id INT PRIMARY KEY AUTO_INCREMENT,
    cartoon_name VARCHAR(100) NOT NULL,
    character_name VARCHAR(100) NOT NULL,
    channel_id INT,
    genre VARCHAR(50) NOT NULL,
    language VARCHAR(50) DEFAULT 'Hindi',
    country VARCHAR(50) DEFAULT 'India',
    release_year INT CHECK (release_year >= 1950),
    total_episodes INT CHECK (total_episodes > 0),
    rating DECIMAL(3,1) CHECK (rating BETWEEN 0 AND 10),
    age_group VARCHAR(20) DEFAULT 'Kids',
    creator_name VARCHAR(100) NOT NULL,
    production_company VARCHAR(100),
    character_type VARCHAR(50),
    city VARCHAR(50),
    state VARCHAR(50),
    website VARCHAR(150) UNIQUE,
    contact_email VARCHAR(100) UNIQUE,
    is_active BOOLEAN DEFAULT TRUE,
    cartoon_code VARCHAR(20) NOT NULL UNIQUE,
    FOREIGN KEY (channel_id)
        REFERENCES cartoon_channels(channel_id)
);
